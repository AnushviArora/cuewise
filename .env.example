# Copy to .env.local (which is gitignored) and fill in.
# Server-only: read in src/lib/server/env.ts. Do NOT prefix with NEXT_PUBLIC_,
# or Next.js would bundle it into browser code.
OPENAI_API_KEY=

# Optional. Cheap model for slide-term extraction and caption correction (default: gpt-4o-mini).
# OPENAI_TEXT_MODEL=gpt-4o-mini
# Optional. Point at an OpenAI-compatible server (e.g. a local mock for testing).
# OPENAI_BASE_URL=
